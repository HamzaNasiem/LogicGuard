data/results/phase1/results_llama2_7b.json
data/results/phase1/results_llama32_3b.json
data/results/phase1/results_mistral_7b.json
data/results/phase1/truthfulqa_validation.json
data/results/phase1/metrics_report.json
data/results/phase1/metrics_report.txt
data/results/phase1/paper_tables_final.txt
data/results/phase1/truthfulqa_validation_report.txt

